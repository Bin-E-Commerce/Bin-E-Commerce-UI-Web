# ============================================================================
# Mẫu biến môi trường cho Web Bin E-Commerce
# ============================================================================
# Sao chép file này thành .env trước khi chạy Web:
#   Copy-Item .env.example .env
#
# Các biến NEXT_PUBLIC_* được đưa vào bundle trình duyệt, vì vậy không đặt
# password, token private hoặc secret backend vào file này.
# ============================================================================

# ----------------------------------------------------------------------------
# 01. Runtime của Next.js
# ----------------------------------------------------------------------------
NODE_ENV=development                         # development | test | production

# ----------------------------------------------------------------------------
# 02. Kết nối API Gateway
# ----------------------------------------------------------------------------
# Khi chạy Docker Compose root, API Gateway publish tại host port 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000   # Không trỏ trực tiếp tới service nội bộ

# ----------------------------------------------------------------------------
# 03. Đăng nhập OIDC với Keycloak
# ----------------------------------------------------------------------------
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080 # URL Keycloak public từ trình duyệt
NEXT_PUBLIC_KEYCLOAK_REALM=bin-ecommerce       # Realm phát hành token
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web-client      # Public client ID của Web

# ----------------------------------------------------------------------------
# 04. URL của Web và metadata
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:5173    # URL dùng cho absolute URL/metadata
